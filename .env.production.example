# .env.production.example
# ⚠️  NUNCA COMMITEAR VALORES REALES - USAR SOLO COMO REFERENCIA
# Copiar este archivo a .env.production.local y rellenar con valores reales

# ─────────────────────────────────────────────────────────────────
# SUPABASE - CREDENCIALES DE PRODUCCIÓN
# ─────────────────────────────────────────────────────────────────
# Obtener de: https://supabase.com/dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ─────────────────────────────────────────────────────────────────
# APLICACIÓN
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://sync-deea.vercel.app
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=SYNC DEEA

# ─────────────────────────────────────────────────────────────────
# ZONA HORARIA
# ─────────────────────────────────────────────────────────────────
TZ=America/Bogota

# ─────────────────────────────────────────────────────────────────
# RESEND (Emails - opcional)
# ─────────────────────────────────────────────────────────────────
# Obtener de: https://resend.com/api-keys
NEXT_PUBLIC_RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────
# ANALYTICS & MONITORING (opcional)
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ─────────────────────────────────────────────────────────────────
# VERCEL CRON SECRET (para autenticar cron jobs)
# ─────────────────────────────────────────────────────────────────
# Generar: openssl rand -hex 32
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
