"use client";

import React, { useEffect, useState } from "react";
import { Semaforo } from "@/components/base/Semaforo";
import { DiasRestantes, DiasRestantesSimple } from "@/components/base/DiasRestantes";

// Datos de ejemplo (en producción vendrían de Supabase)
const datosEjemplo = {
  kpi: {
    peticionesVencidas: 2,
    peticionesCriticas: 5,
    peticionesPendientes: 12,
    documentosSinAsignar: 3,
    contratosActivos: 8,
    porcentajeEjecucion: 65,
  },
  alertas: [
    {
      id: 1,
      tipo: "peticion",
      radicado: "E-2024-0042",
      asunto: "Solicitud de información - Presupuesto 2024",
      solicitante: "Juan García",
      diasRestantes: 1,
      semaforo: "Rojo" as const,
      fecha_vencimiento: new Date(Date.now() + 1 * 24 * 60 * 60 * 1000),
    },
    {
      id: 2,
      tipo: "contrato",
      numero: "CNT-2024-0015",
      objeto: "Suministro de equipos de cómputo",
      contratista: "TechSolutions S.A.S.",
      diasRestantes: 3,
      semaforo: "Ámbar" as const,
      fecha_vencimiento: new Date(Date.now() + 3 * 24 * 60 * 60 * 1000),
    },
    {
      id: 3,
      tipo: "peticion",
      radicado: "E-2024-0051",
      asunto: "Derecho de petición - Nómina funcionarios",
      solicitante: "María López",
      diasRestantes: 2,
      semaforo: "Rojo" as const,
      fecha_vencimiento: new Date(Date.now() + 2 * 24 * 60 * 60 * 1000),
    },
  ],
  agenda: [
    {
      id: 1,
      titulo: "Consejo de Gobierno",
      hora: "09:00",
      participantes: 8,
      ubicacion: "Sala Junta Directiva",
    },
    {
      id: 2,
      titulo: "Reunión técnica - CMDR",
      hora: "14:00",
      participantes: 12,
      ubicacion: "Sala de capacitación",
    },
  ],
};

interface KPICard {
  label: string;
  valor: number | string;
  icon: string;
  color: string;
  enlace?: string;
}

interface Alerta {
  id: number;
  tipo: "peticion" | "contrato";
  radicado?: string;
  numero?: string;
  asunto?: string;
  objeto?: string;
  solicitante?: string;
  contratista?: string;
  diasRestantes: number;
  semaforo: "Verde" | "Ámbar" | "Rojo" | "Vencido";
  fecha_vencimiento: Date;
}

export default function Dashboard() {
  const [, setDatos] = useState(datosEjemplo);

  useEffect(() => {
    // TODO: En producción, cargar datos de Supabase
    // const cargarDatos = async () => {
    //   const kpi = await obtenerKPIDashboard();
    //   const alertas = await obtenerPeticionesCriticas();
    //   setDatos({ kpi, alertas, ... });
    // };
    // cargarDatos();
  }, []);

  const { kpi, alertas, agenda } = datosEjemplo;

  const kpiCards: KPICard[] = [
    {
      label: "Peticiones vencidas",
      valor: kpi.peticionesVencidas,
      icon: "🔴",
      color: "var(--color-semaforo-rojo)",
      enlace: "/peticiones?semaforo=Vencido",
    },
    {
      label: "Peticiones críticas",
      valor: kpi.peticionesCriticas,
      icon: "⚠️",
      color: "var(--color-semaforo-ambar)",
      enlace: "/peticiones?semaforo=Ámbar,Rojo",
    },
    {
      label: "Pendientes abiertos",
      valor: kpi.peticionesPendientes,
      icon: "📋",
      color: "var(--color-acento-principal)",
      enlace: "/peticiones?estado=Recibido",
    },
    {
      label: "Sin asignar",
      valor: kpi.documentosSinAsignar,
      icon: "📂",
      color: "var(--color-tinta-secundaria)",
      enlace: "/peticiones?responsable=Sin%20asignar",
    },
    {
      label: "Contratos activos",
      valor: kpi.contratosActivos,
      icon: "📑",
      color: "#2196F3",
      enlace: "/contratos?estado=Activo",
    },
    {
      label: "Ejecución presupuestal",
      valor: `${kpi.porcentajeEjecucion}%`,
      icon: "📊",
      color: kpi.porcentajeEjecucion >= 80 ? "var(--color-semaforo-verde)" : "var(--color-semaforo-ambar)",
      enlace: "/proyectos/presupuesto",
    },
  ];

  return (
    <div className="dashboard">
      {/* Encabezado */}
      <div className="dashboard-header">
        <h1>Dashboard Ejecutivo</h1>
        <p className="dashboard-subtitle">
          Bienvenido al sistema de control y seguimiento integral
        </p>
      </div>

      {/* KPIs */}
      <section className="kpi-section">
        <h2 className="section-title">KPIs Ejecutivos</h2>
        <div className="kpi-grid">
          {kpiCards.map((kpi) => (
            <a
              key={kpi.label}
              href={kpi.enlace || "#"}
              className="kpi-card"
              style={{
                borderLeftColor: kpi.color,
              } as React.CSSProperties}
            >
              <div className="kpi-icon">{kpi.icon}</div>
              <div className="kpi-content">
                <p className="kpi-label">{kpi.label}</p>
                <p
                  className="kpi-valor"
                  style={{ color: kpi.color } as React.CSSProperties}
                >
                  {kpi.valor}
                </p>
              </div>
              <div className="kpi-arrow">→</div>
            </a>
          ))}
        </div>
      </section>

      {/* Alertas que exigen acción */}
      <section className="alertas-section">
        <h2 className="section-title">⚠️ Términos que exigen acción inmediata</h2>
        {alertas.length > 0 ? (
          <div className="alertas-lista">
            {alertas.map((alerta) => (
              <div
                key={alerta.id}
                className="alerta-item"
                style={{
                  borderLeftColor:
                    alerta.semaforo === "Rojo"
                      ? "var(--color-semaforo-rojo)"
                      : "var(--color-semaforo-ambar)",
                } as React.CSSProperties}
              >
                <div className="alerta-semaforo">
                  <Semaforo estado={alerta.semaforo} tamaño="md" />
                </div>

                <div className="alerta-content">
                  <div className="alerta-header">
                    <h4>
                      {alerta.tipo === "peticion"
                        ? alerta.radicado
                        : alerta.numero}
                    </h4>
                    <span className="alerta-tipo">
                      {alerta.tipo === "peticion" ? "Petición" : "Contrato"}
                    </span>
                  </div>

                  <p className="alerta-asunto">
                    {alerta.tipo === "peticion"
                      ? alerta.asunto
                      : alerta.objeto}
                  </p>

                  <p className="alerta-solicitante">
                    {alerta.tipo === "peticion"
                      ? `Solicitante: ${alerta.solicitante}`
                      : `Contratista: ${alerta.contratista}`}
                  </p>
                </div>

                <div className="alerta-tiempo">
                  <DiasRestantes
                    fechaVencimiento={alerta.fecha_vencimiento}
                    variant="compact"
                    showSemaforo={false}
                  />
                </div>

                <a href="#" className="alerta-link">
                  Ver detalles →
                </a>
              </div>
            ))}
          </div>
        ) : (
          <div className="empty-state">
            <p>✅ No hay términos críticos en este momento</p>
          </div>
        )}
      </section>

      {/* Agenda del día */}
      <section className="agenda-section">
        <h2 className="section-title">📅 Agenda de hoy</h2>
        {agenda.length > 0 ? (
          <div className="agenda-lista">
            {agenda.map((evento) => (
              <div key={evento.id} className="agenda-item">
                <div className="agenda-hora">
                  <span className="hora">{evento.hora}</span>
                </div>

                <div className="agenda-content">
                  <h4>{evento.titulo}</h4>
                  <div className="agenda-meta">
                    <span>📍 {evento.ubicacion}</span>
                    <span>👥 {evento.participantes} participantes</span>
                  </div>
                </div>

                <a href="/agenda" className="agenda-link">
                  Ver reunión →
                </a>
              </div>
            ))}
          </div>
        ) : (
          <div className="empty-state">
            <p>No hay reuniones agendadas para hoy</p>
          </div>
        )}
      </section>

      {/* Estilos */}
      <style jsx>{`
        .dashboard {
          width: 100%;
        }

        .dashboard-header {
          margin-bottom: var(--spacing-2xl);
        }

        .dashboard-header h1 {
          margin-bottom: var(--spacing-md);
        }

        .dashboard-subtitle {
          font-size: var(--font-size-lg);
          color: var(--color-tinta-secundaria);
          margin: 0;
        }

        /* KPI Section */
        .kpi-section {
          margin-bottom: var(--spacing-3xl);
        }

        .section-title {
          font-size: var(--font-size-2xl);
          margin-bottom: var(--spacing-lg);
          color: var(--color-tinta-principal);
        }

        .kpi-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
          gap: var(--spacing-lg);
        }

        .kpi-card {
          display: flex;
          align-items: center;
          gap: var(--spacing-md);
          padding: var(--spacing-lg);
          background-color: var(--color-panel);
          border: 1px solid var(--color-borde-claro);
          border-left: 4px solid;
          border-radius: var(--radius-lg);
          text-decoration: none;
          color: inherit;
          transition: box-shadow var(--transition-base),
            transform var(--transition-base);
          cursor: pointer;
        }

        .kpi-card:hover {
          box-shadow: var(--shadow-lg);
          transform: translateY(-2px);
        }

        .kpi-icon {
          font-size: 2rem;
          flex-shrink: 0;
        }

        .kpi-content {
          flex: 1;
        }

        .kpi-label {
          margin: 0;
          font-size: var(--font-size-sm);
          color: var(--color-tinta-secundaria);
          font-weight: var(--font-weight-medium);
        }

        .kpi-valor {
          margin: var(--spacing-xs) 0 0 0;
          font-size: var(--font-size-2xl);
          font-weight: var(--font-weight-bold);
        }

        .kpi-arrow {
          opacity: 0;
          transition: opacity var(--transition-base);
          color: var(--color-acento-principal);
        }

        .kpi-card:hover .kpi-arrow {
          opacity: 1;
        }

        /* Alertas Section */
        .alertas-section {
          margin-bottom: var(--spacing-3xl);
        }

        .alertas-lista {
          display: flex;
          flex-direction: column;
          gap: var(--spacing-md);
        }

        .alerta-item {
          display: grid;
          grid-template-columns: auto 1fr auto auto;
          gap: var(--spacing-lg);
          align-items: start;
          padding: var(--spacing-lg);
          background-color: var(--color-panel);
          border: 1px solid var(--color-borde-claro);
          border-left: 4px solid;
          border-radius: var(--radius-lg);
        }

        .alerta-semaforo {
          display: flex;
          align-items: center;
        }

        .alerta-content {
          min-width: 0;
        }

        .alerta-header {
          display: flex;
          align-items: baseline;
          gap: var(--spacing-md);
          margin-bottom: var(--spacing-sm);
        }

        .alerta-header h4 {
          margin: 0;
          font-family: var(--font-mono);
          font-size: var(--font-size-base);
        }

        .alerta-tipo {
          display: inline-block;
          background-color: var(--color-fondo);
          padding: 2px 8px;
          border-radius: var(--radius-sm);
          font-size: 0.75rem;
          font-weight: var(--font-weight-semibold);
          color: var(--color-tinta-secundaria);
        }

        .alerta-asunto {
          margin: 0 0 var(--spacing-sm) 0;
          font-weight: var(--font-weight-semibold);
          color: var(--color-tinta-principal);
        }

        .alerta-solicitante {
          margin: 0;
          font-size: var(--font-size-sm);
          color: var(--color-tinta-secundaria);
        }

        .alerta-tiempo {
          text-align: right;
        }

        .alerta-link {
          display: none;
          color: var(--color-acento-principal);
          text-decoration: none;
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-semibold);
          white-space: nowrap;
        }

        @media (min-width: 1024px) {
          .alerta-link {
            display: block;
          }
        }

        /* Agenda Section */
        .agenda-section {
          margin-bottom: var(--spacing-3xl);
        }

        .agenda-lista {
          display: flex;
          flex-direction: column;
          gap: var(--spacing-md);
        }

        .agenda-item {
          display: grid;
          grid-template-columns: auto 1fr auto;
          gap: var(--spacing-lg);
          align-items: center;
          padding: var(--spacing-lg);
          background-color: var(--color-panel);
          border: 1px solid var(--color-borde-claro);
          border-radius: var(--radius-lg);
        }

        .agenda-hora {
          text-align: center;
        }

        .hora {
          display: block;
          font-size: var(--font-size-lg);
          font-weight: var(--font-weight-bold);
          color: var(--color-acento-principal);
          font-family: var(--font-mono);
        }

        .agenda-content {
          min-width: 0;
        }

        .agenda-content h4 {
          margin: 0 0 var(--spacing-sm) 0;
        }

        .agenda-meta {
          display: flex;
          gap: var(--spacing-lg);
          font-size: var(--font-size-sm);
          color: var(--color-tinta-secundaria);
        }

        .agenda-link {
          display: none;
          color: var(--color-acento-principal);
          text-decoration: none;
          font-weight: var(--font-weight-semibold);
          white-space: nowrap;
        }

        @media (min-width: 768px) {
          .agenda-link {
            display: block;
          }
        }

        .empty-state {
          padding: var(--spacing-2xl);
          text-align: center;
          background-color: var(--color-fondo);
          border: 2px dashed var(--color-borde);
          border-radius: var(--radius-lg);
          color: var(--color-tinta-secundaria);
        }

        .empty-state p {
          margin: 0;
          font-size: var(--font-size-base);
        }

        /* Responsive */
        @media (max-width: 768px) {
          .kpi-grid {
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
          }

          .alerta-item {
            grid-template-columns: auto 1fr;
            gap: var(--spacing-md);
          }

          .alerta-tiempo {
            grid-column: 1 / -1;
            text-align: left;
          }

          .alerta-link {
            display: block;
          }

          .agenda-item {
            grid-template-columns: auto 1fr;
          }

          .agenda-meta {
            flex-wrap: wrap;
          }
        }
      `}</style>
    </div>
  );
