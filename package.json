{
  "name": "sync-deea",
  "version": "0.1.0",
  "description": "SYNC DEEA - Sistema de Control y Seguimiento Integral para la Secretaría de Desarrollo Económico, Empresarial y Agrícola",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "supabase:gen-types": "npx supabase gen types typescript --linked > lib/database.types.ts",
    "supabase:push": "npx supabase db push",
    "supabase:pull": "npx supabase db pull",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.8.0",
    "@supabase/supabase-js": "^2.38.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.292.0",
    "next": "^14.0.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^18.2.0",
    "react-email": "^2.0.0",
    "recharts": "^3.10.1",
    "resend": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
