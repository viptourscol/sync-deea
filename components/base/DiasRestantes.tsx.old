/**
 * COMPONENTE DIAS RESTANTES - SYNC DEEA
 * ============================================================================
 * 
 * Contador de días hábiles restantes con color dinámico según semáforo
 * Integra lib/fechas-colombia.ts para cálculos
 * 
 * Props:
 * - fechaVencimiento: Date | string (ISO)
 * - showSemaforo: boolean (mostrar indicador semáforo)
 * - variant: 'compact' | 'expanded'
 * - formato: 'dias' | 'fecha' | 'ambos'
 * 
 * Ejemplo:
 * <DiasRestantes fechaVencimiento="2024-11-15" />
 * → "3 días hábiles" (en verde si > 5 días, ámbar si ≤ 5, rojo si ≤ 2)
 * 
 * Autor: Arquitecto de Software Senior (GovTech)
 */

"use client";

import React, { useMemo } from "react";
import { Semaforo } from "./Semaforo";
import {
  habilesRestantes,
  calcularSemaforo,
  formatearFecha,
} from "@/lib/fechas-colombia";

type Variant = "compact" | "expanded";
type Formato = "dias" | "fecha" | "ambos";
type SemaforoEstado = "Verde" | "Ámbar" | "Rojo" | "Vencido" | "Gris";

interface DiasRestantesProps {
  fechaVencimiento: Date | string;
  showSemaforo?: boolean;
  variant?: Variant;
  formato?: Formato;
  showIcon?: boolean;
  className?: string;
}

export function DiasRestantes({
  fechaVencimiento,
  showSemaforo = true,
  variant = "compact",
  formato = "dias",
  showIcon = true,
  className = "",
}: DiasRestantesProps) {
  // Cálculos memoizados
  const { diasRestantes, semaforo, fechaFormato, estado } = useMemo(() => {
    const fecha =
      typeof fechaVencimiento === "string"
        ? new Date(fechaVencimiento)
        : fechaVencimiento;

    const hoy = new Date();
    const dias = habilesRestantes(fecha, hoy);
    const semaforoEstado = calcularSemaforo(dias);
    const fechaFormateada = formatearFecha(fecha, "es-CO");

    return {
      diasRestantes: dias,
      semaforo: semaforoEstado,
      fechaFormato: fechaFormateada,
      estado: dias < 0 ? "Vencido" : semaforoEstado,
    };
  }, [fechaVencimiento]);

  // Iconos y textos según estado
  const iconConfig = {
    Verde: { icon: "✓", texto: "En tiempo" },
    Ámbar: { icon: "!", texto: "Próximo a vencer" },
    Rojo: { icon: "!!!", texto: "Crítico" },
    Vencido: { icon: "⚠", texto: "Vencido" },
    Gris: { icon: "○", texto: "Sin datos" },
  };

  const colorDias = (() => {
    switch (estado) {
      case "Verde":
        return "var(--color-semaforo-verde)";
      case "Ámbar":
        return "var(--color-semaforo-ambar)";
      case "Rojo":
      case "Vencido":
        return "var(--color-semaforo-rojo)";
      default:
        return "var(--color-tinta-secundaria)";
    }
  })();

  const textoNumero = (() => {
    if (diasRestantes < 0) {
      return `${Math.abs(diasRestantes)} días vencido`;
    }
    return `${diasRestantes} día${diasRestantes === 1 ? "" : "s"} hábil${diasRestantes === 1 ? "" : "es"}`;
  })();

  // Variant: compact (solo número) vs expanded (detalles)
  if (variant === "compact") {
    return (
      <div className={`dias-restantes compact ${className}`}>
        <div className="dias-numero" style={{ color: colorDias }}>
          {showIcon && <span className="icon">{iconConfig[estado].icon}</span>}
          <strong>{diasRestantes}</strong>
        </div>
        {showSemaforo && (
          <Semaforo estado={estado as SemaforoEstado} tamaño="sm" />
        )}

        <style jsx>{`
          .dias-restantes.compact {
            display: inline-flex;
            align-items: center;
            gap: var(--spacing-sm);
            font-size: var(--font-size-sm);
          }

          .dias-numero {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            font-weight: var(--font-weight-bold);
          }

          .icon {
            font-size: 0.875rem;
            opacity: 0.8;
          }
        `}</style>
      </div>
    );
  }

  // Variant: expanded (detalles completos)
  return (
    <div className={`dias-restantes expanded ${className}`}>
      <div className="dias-content">
        <div className="dias-header">
          <div className="dias-numero" style={{ color: colorDias }}>
            {showIcon && (
              <span className="icon">{iconConfig[estado].icon}</span>
            )}
            <span className="numero">{diasRestantes}</span>
          </div>
          {showSemaforo && (
            <Semaforo estado={estado as SemaforoEstado} etiqueta tamaño="sm" />
          )}
        </div>

        <div className="dias-info">
          {(formato === "dias" || formato === "ambos") && (
            <p className="dias-texto">{textoNumero}</p>
          )}
          {(formato === "fecha" || formato === "ambos") && (
            <p className="fecha-texto">Vencimiento: {fechaFormato}</p>
          )}
          <p className="estado-texto">{iconConfig[estado].texto}</p>
        </div>
      </div>

      <style jsx>{`
        .dias-restantes.expanded {
          padding: var(--spacing-md);
          background-color: rgba(0, 0, 0, 0.02);
          border-left: 4px solid ${colorDias};
          border-radius: var(--radius-md);
        }

        .dias-content {
          display: flex;
          flex-direction: column;
          gap: var(--spacing-sm);
        }

        .dias-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
        }

        .dias-numero {
          display: flex;
          align-items: baseline;
          gap: 0.5rem;
          font-weight: var(--font-weight-bold);
        }

        .icon {
          font-size: 1.25rem;
          line-height: 1;
        }

        .numero {
          font-size: var(--font-size-2xl);
          line-height: 1;
        }

        .dias-info {
          display: flex;
          flex-direction: column;
          gap: var(--spacing-xs);
          font-size: 0.875rem;
        }

        .dias-texto {
          margin: 0;
          font-weight: var(--font-weight-semibold);
          color: var(--color-tinta-principal);
        }

        .fecha-texto {
          margin: 0;
          color: var(--color-tinta-secundaria);
        }

        .estado-texto {
          margin: 0;
          color: ${colorDias};
          font-weight: var(--font-weight-semibold);
        }
      `}</style>
    </div>
  );
}

/**
 * Versión simple para mostrar solo el número
 * Útil para tablas y listados
 */
export function DiasRestantesSimple({
  fechaVencimiento,
  className = "",
}: {
  fechaVencimiento: Date | string;
  className?: string;
}) {
  const diasRestantes = useMemo(() => {
    const fecha =
      typeof fechaVencimiento === "string"
        ? new Date(fechaVencimiento)
        : fechaVencimiento;
    return habilesRestantes(fecha, new Date());
  }, [fechaVencimiento]);

  const color = (() => {
    if (diasRestantes < 0) return "var(--color-semaforo-rojo)";
    if (diasRestantes <= 2) return "var(--color-semaforo-rojo)";
    if (diasRestantes <= 5) return "var(--color-semaforo-ambar)";
    return "var(--color-semaforo-verde)";
  })();

  return (
    <span className={`dias-simple ${className}`} style={{ color }}>
      {diasRestantes < 0
        ? `${Math.abs(diasRestantes)}V`
        : `${diasRestantes}d`}
    </span>
  );
}
