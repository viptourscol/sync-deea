# ============================================================================
# CONFIGURACIÓN SYNC DEEA - VARIABLES DE ENTORNO
# ============================================================================
# 
# Copiar este archivo como .env.local y llenar con valores reales
# NUNCA comitir .env.local al repositorio
#
# Documentación:
# - Supabase: https://supabase.com/docs
# - Resend: https://resend.com/docs
# - Vercel: https://vercel.com/docs

# ============================================================================
# SUPABASE - Database, Auth & Storage
# ============================================================================
# Obtener en: https://app.supabase.com/projects
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=xxxxx_service_role_key_aqui

# ============================================================================
# RESEND - Email Transaccional
# ============================================================================
# Obtener en: https://resend.com/api-keys
# Nota: Opcional en desarrollo (fallará gracefully si no se configura)
RESEND_API_KEY=re_xxxxx_tu_api_key

# ============================================================================
# ZONA HORARIA Y LOCALIZACIÓN
# ============================================================================
# Colombia UTC-5 (sin daylight saving time)
TZ=America/Bogota

# ============================================================================
# AMBIENTE DE EJECUCIÓN
# ============================================================================
# Valores: development | staging | production
NEXT_PUBLIC_ENV=development

# URL base de la aplicación (para enlaces en correos, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# SEGURIDAD
# ============================================================================
# JWT secret para sesiones (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET=xxxxx_secret_aleatorio_aqui
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# LOGGING Y DEBUGGING
# ============================================================================
# Nivel de verbosidad: debug | info | warn | error
LOG_LEVEL=debug

# Habilitar logs de Supabase
NEXT_PUBLIC_SUPABASE_DEBUG=false

# ============================================================================
# STRIPE (Opcional - para suscripciones futuras)
# ============================================================================
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx

# ============================================================================
# SENTRY (Opcional - para monitoreo en producción)
# ============================================================================
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ============================================================================
# CRON JOBS (Vercel)
# ============================================================================
# Token para autorizar llamadas a cron jobs
CRON_SECRET=xxxxx_secret_aleatorio_para_cron
